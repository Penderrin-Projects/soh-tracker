{
    "compilerOptions": {
        "target": "esnext",
        "allowSyntheticDefaultImports": false,
        "checkJs": false,
        "baseUrl": "./src",
        "paths": {
            "/script/*": [
                "./script/*"
            ],
            "/GameTrackerJS/*": [
                "../node_modules/gametrackerjs/src/*"
            ],
            "/emcJS/*": [
                "../node_modules/emcjs/src/*"
            ],
            "/JSEditors/*": [
                "../node_modules/jseditors/src/*"
            ],
            "/rtc/*": [
                "../node_modules/rtcclient/src/*"
            ],
            "/ArchipelagoJS/*": [
                "../node_modules/archipelagojs/src/*"
            ]
        }
    }
}
