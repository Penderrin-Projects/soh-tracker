{
  "name": "soh-tracker",
  "description": "Ship of Harkinian rando auto-tracker (built on Track-OOT by Denis Weiß/ZidArgs, MIT)",
  "author": "Penderrin",
  "license": "MIT",
  "main": "soh-integration/electron/main.js",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "fork of https://bitbucket.org/zidargs/track-oot"
  },
  "scripts": {
    "dev-build": "node ./soh-integration/dev-build.js",
    "dev-build-clean": "node ./soh-integration/dev-build.js --clean",
    "start": "electron .",
    "dev": "npm run dev-build && npm run start",
    "build": "gulp build",
    "buildDev": "gulp buildDev",
    "watch": "gulp watch -nocompress",
    "serve": "node --trace-deprecation ./server.js",
    "lint": "eslint .",
    "lintfix": "eslint --fix ."
  },
  "dependencies": {
    "archipelagojs": "git+https://bitbucket.org/zidargs/archipelagojs.git/#1.1.0",
    "chokidar": "^3.6.0",
    "emcjs": "git+https://bitbucket.org/zidargs/emcjs.git/#0.24.3",
    "gametrackerjs": "git+https://bitbucket.org/zidargs/gametrackerjs.git/#0.8.6",
    "jseditors": "git+https://bitbucket.org/zidargs/jseditors.git/#0.3.0",
    "jswebservice": "git+https://bitbucket.org/zidargs/jswebservice.git/#2.1.5",
    "rtcclient": "git+https://bitbucket.org/zidargs/rtcclient.git/#1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-syntax-import-assertions": "^7.27.1",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@stylistic/eslint-plugin": "^5.4.0",
    "del": "^5.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.36.0",
    "glob-all": "^3.1.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^7.0.1",
    "gulp-eslint": "^6.0.0",
    "gulp-filelist": "^2.0.5",
    "gulp-htmlmin": "^5.0.1",
    "gulp-jsonminify": "^1.1.0",
    "gulp-newer": "^1.4.0",
    "gulp-svgo": "^2.1.0",
    "gulp-terser": "^1.4.1",
    "through": "^2.3.8"
  },
  "build": {
    "appId": "com.tabor.soh-tracker",
    "productName": "SoH Rando Tracker",
    "files": [
      "dev/**/*",
      "soh-integration/electron/**/*",
      "soh-integration/mappings/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build-dist"
    },
    "win": {
      "target": ["portable", "nsis"]
    }
  }
}
