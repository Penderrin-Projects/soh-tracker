{
    "language": {
        "category": "settings",
        "type": "choice",
        "default": "en_us",
        "values": "I18n.languages"
    },
    "font": {
        "category": "settings",
        "type": "choice",
        "default": "font_default",
        "values": [
            "font_default",
            "font_charlemagne",
            "font_ravenna",
            "font_returnofganon",
            "font_zeldadx",
            "font_triforce",
            "font_sheikah"
        ]
    },
    "layout": {
        "category": "settings",
        "type": "choice",
        "default": "map-compact",
        "values": [
            "items",
            "items-list",
            "map-right",
            "items-dt",
            "items-list-dt",
            "map-right-dt",
            "map-right-dtr",
            "map-center",
            "map-compact",
            "compact",
            "flat",
            "essential-map",
            "essential-map-key"
        ]
    },
    "color_blind_mode": {
        "category": "settings",
        "type": "check",
        "default": true
    },
    "sublist_collapsible": {
        "category": "settings",
        "type": "choice",
        "default": "start_expanded",
        "values": [
            "off",
            "start_expanded",
            "start_collapsed"
        ]
    },
    "item_size": {
        "category": "settings",
        "type": "-range",
        "min": 32,
        "max": 64,
        "default": 40
    },
    "autosave_time": {
        "category": "settings",
        "type": "number",
        "min": 0,
        "max": 120,
        "default": 10
    },
    "autosave_amount": {
        "category": "settings",
        "type": "number",
        "min": 1,
        "max": 10,
        "default": 4
    },
    "unknown_dungeon_need_both": {
        "category": "settings",
        "type": "check",
        "default": false
    },
    "use_custom_logic": {
        "category": "settings",
        "type": "check",
        "default": false
    },
    "debug_logic": {
        "category": "debug",
        "type": "choice",
        "default": "off",
        "values": [
            "off",
            "on",
            "extended"
        ]
    },
    "show_state_init_window": {
        "category": "settings",
        "type": "check",
        "default": true
    }
}