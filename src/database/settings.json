        "category": "settings",
        "type": "color",
        "default": "#000000",
        "resettable": true
    },
    "use_custom_logic": {
        "category": "settings",
        "type": "check",
        "default": false
    },
    "autosave_time": {
        "category": "savestate",
        "type": "number",
        "min": 0,
        "max": 120,
        "default": 10,
        "resettable": true
