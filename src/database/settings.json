            "font_ravenna",
            "font_returnofganon",
            "font_zeldadx",
            "font_triforce",
            "font_sheikah"
        ]
    },
    "layout": {
        "category": "settings",
        "type": "choice",
        "default": "map-compact",
        "values": [
            "items",
            "items-list",
            "map-right",
            "items-dt",
            "items-list-dt",
            "map-right-dt",
            "map-right-dtr",
            "map-center",
            "map-compact",
            "compact",
            "flat",
            "essential-map",
            "essential-map-key",
            "standard-essential-map"
        ]
