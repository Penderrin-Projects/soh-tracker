    "location_status_unavailable_color": {
        "category": "a11y",
        "type": "color",
        "default": "#ff0000",
        "resettable": true
    },
    "location_status_possible_color": {
        "category": "a11y",
        "type": "color",
        "default": "#ffff00",
        "resettable": true
